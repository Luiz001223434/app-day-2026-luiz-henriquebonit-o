function init(){
$('#servicos').innerHTML=SERV.map(s=>`<a class="card" href="${s[2]}" style="text-decoration:none;color:inherit"><h3>${s[0]}</h3><p>${s[1]}</p></a>`).join('');
$('#guiaL').innerHTML=GUIA.map((g,i)=>`<details id="g${i}"><summary>${g[0]}</summary><p>${g[1]}</p><button class="btn ghost" data-fav="g${i}">${fav.includes('g'+i)?'♥ Favoritado':'♡ Favoritar'}</button></details>`).join('');
$('#ingL').innerHTML=ING.map((g,i)=>`<div class="card" id="i${i}">${fbtn('i'+i)}<h3>${g[0]}</h3><p class="row">${g[1]}</p><p class="row"><b>Benefícios:</b> ${g[2]}</p><p class="row"><b>Indicação:</b> ${g[3]}</p></div>`).join('');
const cats=[...new Set(ART.map(a=>a[1]))];$('#ac').innerHTML='<option value="">Todas</option>'+cats.map(c=>`<option>${c}</option>`).join('');
$('#freq').innerHTML=[1,2,3,4,5,6,7].map(n=>`<option value="${n}"${n==3?' selected':''}>${n}x</option>`).join('');
drawProd();drawArt();drawFav();drawCal();
}
function drawProd(){const q=$('#pq').value.toLowerCase(),t=$('#pt').value,e=$('#pe').value;
const l=prods().filter(p=>(!q||(p.n+p.c+p.a+p.ind).toLowerCase().includes(q))&&(!t||p.t==t||p.t=='Todos')&&(!e||p.e==e));
$('#prodL').innerHTML=l.length?l.map(p=>`<div class="card">${fbtn(p.id)}<h3>${E(p.n)}</h3><span class="tag">${E(p.e)}</span><span class="tag">${E(p.t)}</span><p class="row"><b>Composição:</b> ${E(p.c||'—')}</p><p class="row"><b>Ativos:</b> ${E(p.a||'—')}</p><p class="row"><b>Indicação:</b> ${E(p.ind||'—')}</p><p class="row"><b>Benefícios:</b> ${E(p.b||'—')}</p>${p.own?`<button class="btn ghost" data-del="${p.id}">Remover</button>`:''}</div>`).join(''):'<p class="empty">Nenhum produto encontrado. Ajuste os filtros ou cadastre um produto abaixo.</p>'}
function drawArt(){const c=$('#ac').value;const bg=['#f2d5d8','#ead7bd','#d9bfae','#f4e8dd'];
$('#artL').innerHTML=ART.map((a,i)=>({a,i})).filter(x=>!c||x.a[1]==c).map(({a,i})=>`<article class="card">${fbtn('a'+i)}<div class="thumb" style="background:${bg[i%4]}">${a[2]}</div><small>${a[1]}</small><h3>${a[0]}</h3><p>${a[3].slice(0,110)}…</p><button class="btn ghost" data-art="${i}">Ler artigo</button></article>`).join('')}
function drawFav(){const l=FAV_ITEMS().filter(i=>fav.includes(i.id));
$('#favL').innerHTML=l.length?l.map(i=>`<div class="card">${fbtn(i.id)}<small>${i.k}</small><h3>${E(i.t)}</h3><p class="row">${E(i.d.slice(0,120))}…</p></div>`).join(''):'<p class="empty">Você ainda não tem favoritos. Toque no ♡ de qualquer conteúdo para guardá-lo aqui.</p>'}
document.addEventListener('click',e=>{
const f=e.target.closest('[data-fav]');if(f){const id=f.dataset.fav;fav=fav.includes(id)?fav.filter(x=>x!=id):[...fav,id];set('fav',fav);init();return}
const a=e.target.closest('[data-art]');if(a){const x=ART[a.dataset.art];$('#dbody').innerHTML=`<small>${x[1]}</small><h3>${x[0]}</h3><p>${x[3]}</p>`;dlg.showModal();return}
const d=e.target.closest('[data-del]');if(d){set('myprods',get('myprods',[]).filter(p=>p.id!=d.dataset.del));fav=fav.filter(x=>x!=d.dataset.del);set('fav',fav);init()}
const r=e.target.closest('[data-res]');if(r){const x=r.dataset.res.split(',');$('#freq').value=x[0];$('#ress').value=x[1];drawCal();$('#cronograma').scrollIntoView()}});
['#pq','#pt','#pe'].forEach(s=>$(s).addEventListener('input',drawProd));$('#ac').addEventListener('input',drawArt);
$('#pform').addEventListener('submit',e=>{e.preventDefault();const n=$('#n').value.trim();if(!n)return;
const l=get('myprods',[]);l.push({id:'u'+Date.now(),n,c:$('#c').value.trim(),a:$('#a').value.trim(),ind:$('#i').value.trim(),t:$('#t').value,b:$('#b').value.trim(),e:$('#e').value});
set('myprods',l);e.target.reset();$('#pmsg').textContent='Produto salvo.';setTimeout(()=>$('#pmsg').textContent='',2500);init()});
// Questionário
const Q=[['tipo','Tipo de cabelo',['1 · Liso','2 · Ondulado','3 · Cacheado','4 · Crespo']],['esp','Espessura do fio',['Fina','Média','Grossa']],['por','Porosidade',['Baixa','Média','Alta']],['cur','Curvatura',['A · aberta','B · média','C · fechada']],['den','Densidade capilar',['Baixa','Média','Alta']],['res','Nível de ressecamento',['Leve','Moderado','Intenso']]];
$('#quiz').innerHTML=Q.map(g=>`<fieldset class="grp"><legend>${g[1]}</legend><div class="chips">${g[2].map((o,i)=>`<label><input type="radio" name="${g[0]}" value="${i}" required><span>${o}</span></label>`).join('')}</div></fieldset>`).join('')+'<button class="btn">Ver meu perfil capilar</button>';
$('#quiz').addEventListener('submit',e=>{e.preventDefault();const v={};Q.forEach(g=>v[g[0]]=+new FormData(e.target).get(g[0]));set('perfil',v);showPerfil(v);});
function showPerfil(v){const T=['liso','ondulado','cacheado','crespo'],ES=['fino','médio','grosso'],PO=['baixa','média','alta'],CU=['A','B','C'],DE=['baixa','média','alta'],RE=['leve','moderado','intenso'];
const r=[];
r.push([`Fios ${T[v.tipo]}s, curvatura ${CU[v.cur]}`,['Cabelos lisos tendem a ficar oleosos mais rápido: lave a raiz com mais frequência e condicione só o comprimento.','Cabelos ondulados pedem leveza: cremes leves e mousse mantêm a ondulação sem pesar.','Cachos precisam de umidade constante: finalize em camadas e evite escovar a seco.','Cabelos crespos ressecam mais, pois o sebo percorre menos o fio: priorize hidratação, umectantes e selagem.'][v.tipo]]);
r.push([`Porosidade ${PO[v.por]}`,['Cutícula mais fechada: prefira texturas leves e use calor suave (touca térmica) para ajudar a penetração. Evite excesso de proteína e óleos pesados.','Equilíbrio entre absorção e retenção: mantenha o cronograma balanceado entre hidratação, nutrição e reconstrução.','Cutícula aberta: foque em reconstrução e selagem com manteigas e óleos, e finalize com leave-in para reter a água.'][v.por]]);
r.push([`Fio ${ES[v.esp]}, densidade ${DE[v.den]}`,[`Fios finos pedem produtos leves e pouca quantidade para não pesar.`,`Fios médios aceitam a maioria das texturas; ajuste conforme o resultado.`,`Fios grossos aguentam texturas ricas, como máscaras cremosas e manteigas.`][v.esp]+' '+['Com pouca densidade, aplique produto com moderação e evite finalizadores pesados.','Densidade média: aplique por seções para distribuir bem.','Cabelo volumoso: divida em seções e use mais produto na aplicação.'][v.den]]);
r.push([`Ressecamento ${RE[v.res]}`,['Mantenha o cronograma regular e reforce a proteção contra calor e sol.','Priorize hidratação e nutrição, com reconstrução quinzenal.','Aumente hidratação e nutrição, faça reconstrução com frequência controlada e avalie corte das pontas.'][v.res]]);
const fr=[4,3,2,2][v.tipo];
const el=$('#perfil');el.className='res card on';el.innerHTML=`<h3>Seu perfil: cabelo ${T[v.tipo]} ${CU[v.cur]}, ${ES[v.esp]}, porosidade ${PO[v.por]}</h3>`+r.map(x=>`<p><b>${x[0]}.</b> ${x[1]}</p>`).join('')+`<p><button class="btn" data-res="${fr},${v.res}">Montar cronograma para este perfil</button></p>`;el.scrollIntoView({block:'nearest'})}
// Cronograma
const NM={H:'Hidratação',N:'Nutrição',R:'Reconstrução'};
function pat(r){return [['H','N','H','N','R','N'],['H','N','R'],['H','N','R','H','N','R']][r]}
function washDays(n){const s=new Set();for(let i=0;i<n;i++)s.add(Math.round(i*7/n)%7);return s}
function drawCal(){const n=+$('#freq').value,r=+$('#ress').value,m=$('#vis').value=='m',wd=washDays(n),p=pat(r),dn=['Seg','Ter','Qua','Qui','Sex','Sáb','Dom'];let k=0,h=dn.map(d=>`<div class="hd">${d}</div>`).join('');
const cell=(day,idx)=>{if(!wd.has(idx))return`<div>${day||''}<b></b></div>`;const t=p[k++%p.length];return`<div class="${t}"><b>${day||dn[idx]}</b>${NM[t]}</div>`};
if(!m){for(let i=0;i<7;i++)h+=cell('',i)}else{const now=new Date(),y=now.getFullYear(),mo=now.getMonth(),first=(new Date(y,mo,1).getDay()+6)%7,days=new Date(y,mo+1,0).getDate();for(let i=0;i<first;i++)h+='<div style="visibility:hidden"></div>';for(let d=1;d<=days;d++)h+=cell(d,(first+d-1)%7)}
$('#cal').innerHTML=h;$('#calnote').textContent=`${n} lavagem${n>1?'ns':''} por semana. Ciclo de tratamento: ${p.map(x=>NM[x]).join(' → ')}. Ajuste conforme a resposta dos seus fios.`}
['#freq','#ress','#vis'].forEach(s=>$(s).addEventListener('input',drawCal));
// Busca global
$('#q').addEventListener('keydown',e=>{if(e.key!='Enter')return;const q=e.target.value.trim().toLowerCase();if(!q)return;
const l=FAV_ITEMS().filter(i=>(i.t+i.d).toLowerCase().includes(q)).slice(0,12);
$('#dbody').innerHTML=`<h3>Resultados para “${E(q)}”</h3>`+(l.length?l.map(i=>`<p><small>${i.k}</small><br><b>${E(i.t)}</b><br>${E(i.d.slice(0,110))}…</p>`).join(''):'<p class="empty">Nada encontrado. Tente outra palavra, como “porosidade” ou “pantenol”.</p>');dlg.showModal()});
// Tema
$('#tema').onclick=()=>{const d=document.documentElement,dark=getComputedStyle(d).colorScheme.includes('dark');d.dataset.theme=dark?'light':'dark';if(!dark)d.dataset.theme='dark'};
init();const sp=get('perfil',null);if(sp)showPerfil(sp);
</script></body></html>
