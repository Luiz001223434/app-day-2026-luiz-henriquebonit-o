<section id="guia">
  <h2>Guia de cuidados</h2>
  <details class="box"><summary><b>Como identificar a porosidade</b></summary>
    <p>Solte um fio limpo em um copo d'água. Se boia por muito tempo, a porosidade é baixa. Se afunda devagar, média. Se afunda rápido, alta.</p></details>
  <details class="box"><summary><b>Como cuidar de cabelos ressecados</b></summary>
    <p>Use shampoo suave, água morna e condicionador do comprimento às pontas. Hidrate com pantenol ou glicerina e finalize com leave-in.</p></details>
  <details class="box"><summary><b>Como reduzir o frizz</b></summary>
    <p>Hidrate, sele com óleo leve, seque com camiseta ou microfibra em vez de toalha de algodão e evite escovar a seco.</p></details>
  <details class="box"><summary><b>Como cuidar do couro cabeludo</b></summary>
    <p>Lave com shampoo adequado ao seu tipo e massageie com a ponta dos dedos. Coceira, feridas ou queda intensa precisam de avaliação médica.</p></details>
</section>

<section id="produtos">
  <h2>Produtos</h2>
  <div class="box"><b>Máscara de hidratação</b> (pantenol, glicerina, aloe)<br>Para cabelos ressecados e opacos.</div>
  <div class="box"><b>Máscara nutritiva</b> (karité, óleo de argan)<br>Para cabelos secos e sem brilho.</div>
  <div class="box"><b>Reconstrutor</b> (queratina, proteínas vegetais)<br>Para cabelos danificados e com química.</div>
  <div class="box"><b>Leave-in com protetor térmico</b> (pantenol, argan)<br>Para frizz e proteção contra calor.</div>
</section>

<footer>Conteúdo educativo. Não substitui a avaliação de um dermatologista ou tricologista.</footer>

<script>
var NOMES = ["Liso", "Ondulado", "Cacheado", "Crespo"];
var zig = "M10 5";
for (var z = 0; z < 10; z++) zig += " l" + (z % 2 == 0 ? 9 : -9) + " 9";
var TRACOS = [
  "M10 5 L10 95",
  "M10 5 Q24 15 10 25 T10 45 T10 65 T10 85 T10 95",
  "M10 5 C26 5 26 20 10 20 C-6 20 -6 35 10 35 C26 35 26 50 10 50 C-6 50 -6 65 10 65 C26 65 26 80 10 80 C-6 80 -6 95 10 95",
  zig
];
var tipoAtual = 0;

function desenho(i, largura) {
  var d = TRACOS[i];
  return "<svg viewBox='0 0 90 100' width='" + largura + "' height='" + Math.round(largura * 100 / 90) + "' role='img' aria-label='Cabelo " + NOMES[i].toLowerCase() + "'>" +
    "<g fill='none' stroke-linecap='round' stroke-width='3' style='stroke:var(--main)'>" +
    "<path d='" + d + "' transform='translate(8 0)'/><path d='" + d + "' transform='translate(32 0)'/><path d='" + d + "' transform='translate(56 0)'/></g></svg>";
}

function montarTipos() {
  var html = "";
  for (var i = 0; i < 4; i++) {
    html += "<button class='tipo" + (i == tipoAtual ? " sel" : "") + "' onclick='escolher(" + i + ")'>" + desenho(i, 80) + "<br><b>" + (i + 1) + " · " + NOMES[i] + "</b></button>";
  }
  document.getElementById("tipos").innerHTML = html;
}

function escolher(i) {
  tipoAtual = i;
  montarTipos();
}

function verPerfil() {
  var por = +document.getElementById("por").value;
  var res = +document.getElementById("res").value;
  var dicaTipo = [
    "Lave a raiz com mais frequência e condicione só o comprimento.",
    "Use cremes leves e mousse para manter a ondulação sem pesar.",
    "Finalize em camadas e evite escovar a seco.",
    "Priorize hidratação, umectantes e selagem, pois os fios ressecam mais."
  ];
  var dicaPor = [
    "Prefira texturas leves e evite excesso de proteína e óleos pesados.",
    "Mantenha o cronograma equilibrado entre hidratação, nutrição e reconstrução.",
    "Foque em reconstrução e selagem com manteigas e óleos."
  ];
  var dicaRes = [
    "Mantenha a rotina regular e proteja do calor e do sol.",
    "Priorize hidratação e nutrição, com reconstrução quinzenal.",
    "Aumente hidratação e nutrição e avalie cortar as pontas."
  ];
  var box = document.getElementById("perfil");
  box.style.display = "block";
  box.innerHTML = "<h3>Cabelo " + NOMES[tipoAtual].toLowerCase() + "</h3>" +
    "<p><b>Tipo:</b> " + dicaTipo[tipoAtual] + "</p>" +
    "<p><b>Porosidade:</b> " + dicaPor[por] + "</p>" +
    "<p><b>Ressecamento:</b> " + dicaRes[res] + "</p>";
  document.getElementById("freq").value = [4, 3, 2, 2][tipoAtual];
  cronograma();
}

function cronograma() {
  var n = +document.getElementById("freq").value;
  var r = +document.getElementById("res").value;
  var nomes = { H: "Hidratação", N: "Nutrição", R: "Reconstrução" };
  var padroes = [["H", "N", "H", "N", "R", "N"], ["H", "N", "R"], ["H", "N", "R", "H", "N", "R"]];
  var padrao = padroes[r];
  var dias = ["Seg", "Ter", "Qua", "Qui", "Sex", "Sáb", "Dom"];
  var lavar = [false, false, false, false, false, false, false];
  for (var i = 0; i < n; i++) lavar[Math.round(i * 7 / n) % 7] = true;
  var cab = "<tr>", corpo = "<tr>", usado = 0;
  for (var k = 0; k < 7; k++) {
    cab += "<th>" + dias[k] + "</th>";
    if (lavar[k]) {
      var etapa = padrao[usado % padrao.length];
      usado++;
      corpo += "<td class='" + etapa + "'>" + nomes[etapa] + "</td>";
    } else {
      corpo += "<td>-</td>";
    }
  }
  document.getElementById("semana").innerHTML = cab + "</tr>" + corpo + "</tr>";
}

document.getElementById("freq").addEventListener("change", cronograma);
document.getElementById("res").addEventListener("change", cronograma);
montarTipos();
cronograma();
</script>
</body>
</html>
 
