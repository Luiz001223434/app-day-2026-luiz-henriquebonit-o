<section id="tipo">
  <h2>Descubra seu tipo de cabelo</h2>
  <div class="tipos" id="tipos"></div>
  <label for="por">Porosidade</label>
  <select id="por"><option value="0">Baixa</option><option value="1" selected>Média</option><option value="2">Alta</option></select>
  <label for="res">Ressecamento</label>
  <select id="res"><option value="0">Leve</option><option value="1" selected>Moderado</option><option value="2">Intenso</option></select>
  <p><button class="btn" onclick="verPerfil()">Ver meu perfil</button></p>
  <div class="box" id="perfil" style="display:none"></div>
